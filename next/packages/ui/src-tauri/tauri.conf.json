{
  "productName": "Grove",
  "version": "0.1.0",
  "identifier": "dev.grove-next.app",
  "build": {
    "beforeDevCommand": { "script": "npx vite", "cwd": ".." },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": { "script": "npx vite build", "cwd": ".." },
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Grove",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
